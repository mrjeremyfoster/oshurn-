{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oshurn.com/schemas/lead-intake.schema.json",
  "title": "Oshurn Lead Intake",
  "description": "Consent-aware educational/service-interest lead intake contract. It does not authorize regulated financial activity or create an advisory, insurance, or securities relationship.",
  "type": "object",
  "additionalProperties": false,
  "required": ["firstName", "lastName", "email", "phone", "state", "interest", "contactPreference", "consent"],
  "properties": {
    "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "lastName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
    "state": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
    "interest": { "type": "string", "minLength": 1, "maxLength": 120 },
    "contactPreference": { "type": "string", "enum": ["email", "phone", "text"] },
    "consent": { "const": "on" },
    "timing": { "type": "string", "maxLength": 80 },
    "referralSource": { "type": "string", "maxLength": 120 }
  }
}
